---
import PlaygroundLayout from "../../layouts/PlaygroundLayout.astro";
import InspectionDetails from "../../components/playground/InspectionDetails.astro";
import InspectionSettings from "../../components/playground/InspectionSettings.astro";
import { DEFAULT_SIMILARITY_THRESHOLD, STRONG_SIMILARITY_THRESHOLD } from "../../lib/inspection-graph";
import { inspectionTopics, PROFILE_YEARS } from "../../lib/inspection-features";

const description = "Compare inspection patterns across King County food businesses.";
const pageUrl = new URL("/playground/synology", Astro.site ?? Astro.url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  url: pageUrl,
  name: "King County Food Inspection Graph",
  description,
};
---

<PlaygroundLayout
  title="King County Food Inspection Graph"
  description={description}
  structuredData={structuredData}
>
  <div class="inspection-playground">
    <div
      id="synology-graph"
      role="img"
      aria-label="King County food inspection graph. Each node represents one business. Links connect similar inspection profiles. Color shows the most frequent finding topic. Use Graph settings to filter or group businesses."
      data-strong-threshold={STRONG_SIMILARITY_THRESHOLD}
      aria-busy="true"
    ></div>
    <div id="inspection-groups" aria-hidden="true"></div>
    <aside id="inspection-legend" class="graph-legend" aria-label="Graph key" hidden>
      <div class="legend-header">
        <div>
          <strong>Inspection graph</strong>
          <span id="inspection-legend-count" class="legend-count"></span>
        </div>
        <button id="inspection-settings-toggle" type="button" aria-label="Graph settings" aria-haspopup="dialog" aria-expanded="false" aria-controls="inspection-settings">
          <span class="legend-menu-icon" aria-hidden="true"></span>
        </button>
      </div>
      <details open>
        <summary>How to read the graph</summary>
        <p>Links bring similar inspection profiles together. Color shows each business’s most frequent topic in the last {PROFILE_YEARS} years of the export.</p>
        <ul>
          <li><i class="edge-regular"></i> Similar profiles · {Math.round(DEFAULT_SIMILARITY_THRESHOLD * 100)}% to &lt;{Math.round(STRONG_SIMILARITY_THRESHOLD * 100)}%</li>
          <li><i class="edge-strong"></i> Stronger matches · {Math.round(STRONG_SIMILARITY_THRESHOLD * 100)}% and up</li>
          <li><i class="edge-selected"></i> Selected links</li>
        </ul>
      </details>
      <details class="legend-topics">
        <summary>Topic colors</summary>
        <ul>
          {inspectionTopics.map(({ label, color, outline }) => (
            <li><i style={{ backgroundColor: color, borderColor: outline }}></i>{label}</li>
          ))}
        </ul>
      </details>
      <p class="legend-instructions">
        Select a link to compare two businesses.
        <span class="legend-modifiers">Shift-click or Command-click to add or remove individual businesses.</span>
      </p>
    </aside>
    <p id="inspection-empty" role="status" hidden>No businesses match these filters.</p>
    <InspectionDetails />
    <InspectionSettings />
    <div id="synology-graph-status" role="status" aria-live="polite">Preparing restaurant inspection data…</div>
  </div>
</PlaygroundLayout>

<style>
  .inspection-playground {
    --graph-background: #f4f3ed;
    --graph-surface: #fffef9;
    --graph-text: #242c2a;
    --graph-muted: #535c56;
    --graph-border: #d9ddd2;
    --graph-accent: #643c80;
    --graph-risk-1: #5b8d94;
    --graph-risk-2: #2d6875;
    --graph-risk-3: #153e52;
    --graph-risk-unknown: #777674;
    --graph-edge-regular: #988e83;
    --graph-edge-strong: #5c5148;
    --graph-font: system-ui, sans-serif;
    color: var(--graph-text);
    font-family: var(--graph-font);
  }

  #synology-graph {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background-color: var(--graph-background);
    background-image: radial-gradient(#dde1d6 0.8px, transparent 0.8px);
    background-size: 20px 20px;
  }

  #inspection-groups {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #inspection-groups :global(span) {
    position: absolute;
    max-width: min(11rem, 26vw);
    padding: 0.2rem 0.45rem;
    border-radius: 0.35rem;
    background: var(--graph-surface);
    box-shadow: inset 0 -2px var(--topic-color);
    color: var(--graph-text);
    font-size: 0.8125rem;
    font-weight: 650;
    text-align: center;
    transform: translate(-50%, -100%);
  }

  .graph-legend {
    position: fixed;
    z-index: 1;
    top: 1rem;
    left: 1rem;
    width: min(16rem, calc(100vw - 2rem));
    padding: 0.75rem;
    border: 1px solid var(--graph-border);
    border-radius: 0.75rem;
    background: var(--graph-surface);
    box-shadow: 0 4px 20px #242c2a0d;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .legend-header { display: flex; align-items: center; justify-content: space-between; gap: 0.3rem; }
  #inspection-settings-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--graph-border);
    border-radius: 0.45rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  #inspection-settings-toggle:hover { background: color-mix(in srgb, var(--graph-accent) 9%, transparent); }
  #inspection-settings-toggle:focus-visible { outline: 2px solid var(--graph-accent); outline-offset: 2px; }
  .legend-menu-icon {
    width: 1rem;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    box-shadow: 0 -5px currentColor, 0 5px currentColor;
  }

  .graph-legend strong { display: block; font-size: 1rem; }
  .legend-count { display: block; color: var(--graph-muted); }
  .graph-legend details { margin-top: 0.55rem; }
  .graph-legend summary { font-weight: 650; cursor: pointer; }
  .graph-legend p { margin: 0.35rem 0 0; }
  .graph-legend ul { display: grid; gap: 0.2rem; list-style: none; margin: 0.35rem 0 0; padding: 0; }
  .graph-legend li { display: flex; align-items: center; gap: 0.45rem; }
  .graph-legend i { flex: none; width: 0.95rem; height: 3px; border-radius: 2px; }
  .graph-legend .edge-regular { background: var(--graph-edge-regular); }
  .graph-legend .edge-strong { background: var(--graph-edge-strong); }
  .graph-legend .edge-selected { background: var(--graph-accent); }
  .legend-topics li i { width: 0.7rem; height: 0.7rem; border: 1px solid; border-radius: 50%; }
  .graph-legend .legend-instructions { color: var(--graph-muted); }

  @media (max-width: 760px) {
    .graph-legend { top: 0.5rem; left: 0.5rem; padding: 0.5rem 0.65rem; }
    #inspection-groups :global(span) { font-size: 0.7rem; }
  }

  @media (hover: none) { .legend-modifiers { display: none; } }

  #inspection-empty {
    position: fixed;
    inset: 50% auto auto 50%;
    width: max-content;
    max-width: calc(100% - 2rem);
    margin: 0;
    padding: 0.55rem 0.75rem;
    transform: translate(-50%, -50%);
    border: 1px solid var(--graph-border);
    border-radius: 0.4rem;
    background: var(--graph-surface);
    color: var(--graph-muted);
    text-align: center;
    pointer-events: none;
  }

  #synology-graph-status {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    z-index: 2;
    color: var(--graph-text);
    background: var(--graph-background);
    font: 500 15px/1.5 var(--graph-font);
    text-align: center;
    pointer-events: none;
  }

  #synology-graph-status[data-error="true"] {
    color: #8f3427;
  }

  #synology-graph-status[hidden] {
    display: none;
  }
</style>

<script>
  import { createInspectionPairScorer, INSPECTION_NODE_LIMIT } from "../../lib/inspection-graph";
  import {
    defaultInspectionFilters, groupBusinesses, layoutBounds, spiralPosition, type GraphPosition, type InspectionFilters, type InspectionGrouping,
  } from "../../lib/inspection-view";
  import type { LayoutBatch, LayoutResult } from "../../lib/inspection-layout";
  import type { WorkerRequest, WorkerResult } from "../../workers/inspection-graph.worker";
  import { inspectionTopics, otherTopic } from "../../lib/inspection-features";
  import type { FragmentLayer } from "sigma/rendering";
  import type { SigmaEventPayload } from "sigma/types";
  import { renderInspectionDetails } from "../../lib/inspection-details";

  const container = document.querySelector<HTMLDivElement>("#synology-graph");
  const status = document.querySelector<HTMLDivElement>("#synology-graph-status");
  const legend = document.querySelector<HTMLElement>("#inspection-legend");
  const legendCount = document.querySelector<HTMLElement>("#inspection-legend-count");
  const groupLabels = document.querySelector<HTMLElement>("#inspection-groups");
  const settings = document.querySelector<HTMLDialogElement>("#inspection-settings");
  const settingsButton = document.querySelector<HTMLButtonElement>("#inspection-settings-toggle");
  const settingsForm = document.querySelector<HTMLFormElement>("#inspection-settings-form");
  const settingsCount = document.querySelector<HTMLElement>("#inspection-settings-count");
  const empty = document.querySelector<HTMLElement>("#inspection-empty");
  const initializationStartedAt = performance.now();
  let renderer: import("sigma").Sigma | undefined;
  let dataWorker: Worker | undefined;
  let leaving = false;
  let initialized = false;
  let filterFrame = 0;
  let filterTimer = 0;
  let layoutFrame = 0;
  let layoutWorker: Worker | undefined;

  function cancelLayout() {
    cancelAnimationFrame(layoutFrame);
    layoutWorker?.terminate();
    layoutWorker = undefined;
  }

  function showError(message: string) {
    if (!container || !status) return;
    console.error("Could not load restaurant inspection graph", message);
    container.setAttribute("aria-busy", "false");
    status.setAttribute("role", "alert");
    status.dataset.error = "true";
    status.textContent = "Restaurant inspection data could not be loaded. Reload the page to try again.";
  }

  function updateProgress(message: Extract<WorkerResult, { type: "progress" }>) {
    if (!status) return;
    if (message.phase === "reading") {
      status.textContent = `Reading inspection records: ${message.rowCount.toLocaleString()}…`;
      return;
    }
    if (message.phase === "layout") {
      status.textContent = "Arranging businesses by similarity…";
      return;
    }
    const candidates = message.candidatePairsScored
      ? ` ${message.candidatePairsScored.toLocaleString()} candidate pairs scored…`
      : "";
    status.textContent = `Scoring similarities for ${(message.restaurantCount ?? 0).toLocaleString()} restaurants…${candidates}`;
  }

  async function createGraph(message: Extract<WorkerResult, { type: "ready" }>) {
    if (!container || !status) return;
    try {
      const [{ default: Sigma, DEFAULT_STYLES }, { default: Graph }] = await Promise.all([
        import("sigma"),
        import("graphology"),
      ]);
      if (leaving) return;
      const graph = new Graph();
      const nodeOutline: FragmentLayer = {
        name: "outlinedNode",
        uniforms: [],
        attributes: [
          { name: "fill", size: 4, type: WebGL2RenderingContext.UNSIGNED_BYTE, normalized: true, source: "color" },
          { name: "outline", size: 4, type: WebGL2RenderingContext.UNSIGNED_BYTE, normalized: true, source: "outlineColor" },
          { name: "outlineWidth", size: 1, type: WebGL2RenderingContext.FLOAT, source: "outlineWidth" },
        ],
        glsl: `
          vec4 layer_outlinedNode(vec4 fill, vec4 outline, float outlineWidth) {
            float innerEdge = -outlineWidth * context.pixelToUV;
            float blend = smoothstep(innerEdge - context.aaWidth, innerEdge, context.sdf);
            return mix(fill, outline, blend);
          }
        `,
      };
      const theme = getComputedStyle(container);
      const color = (name: string) => theme.getPropertyValue(`--graph-${name}`).trim();
      const topics = new Map<string, (typeof inspectionTopics)[number] | typeof otherTopic>(
        [...inspectionTopics, otherTopic].map(topic => [topic.id, topic]),
      );
      const strongThreshold = Number(container.dataset.strongThreshold);
      const worldBounds = layoutBounds(message.positions.values()) ?? layoutBounds([{ x: -100, y: -100 }, { x: 100, y: 100 }])!;
      const worldCenter = { x: (worldBounds.x[0] + worldBounds.x[1]) / 2, y: (worldBounds.y[0] + worldBounds.y[1]) / 2 };
      const worldRadius = Math.max(1, Math.min(worldBounds.x[1] - worldBounds.x[0], worldBounds.y[1] - worldBounds.y[0]) / 2);

      type GraphView = Extract<WorkerResult, { type: "ready" | "filtered" }>;
      let view: GraphView = message;
      let businesses = new Map(message.nodes.map(node => [node.id, node]));
      let visibleNodes = new Set(businesses.keys());

      function mergeGraph(view: GraphView) {
        const nameCounts = new Map<string, number>();
        for (const { name } of view.nodes) nameCounts.set(name, (nameCounts.get(name) ?? 0) + 1);
        for (const [index, node] of view.nodes.entries()) {
          const topic = topics.get(node.topic)!;
          const label = nameCounts.get(node.name)! > 1
            ? `${node.name} · ${[node.address, node.city].filter(Boolean).join(", ") || node.businessId}`
            : node.name;
          if (graph.hasNode(node.id)) {
            if (graph.getNodeAttribute(node.id, "label") !== label) graph.setNodeAttribute(node.id, "label", label);
            continue;
          }
          const offset = spiralPosition(index, worldRadius / Math.sqrt(INSPECTION_NODE_LIMIT));
          const position = message.positions.get(node.id) ?? { x: worldCenter.x + offset.x, y: worldCenter.y + offset.y };
          graph.addNode(node.id, {
            label,
            ...position,
            viewOpacity: view.type === "ready" ? 1 : 0,
            size: container!.clientWidth < 600 ? 2.5 : 3.5,
            color: topic.color,
            outlineColor: topic.outline,
          });
        }

        const keys = new Set<string>();
        for (const { source, target, score } of view.edges) {
          const strong = score >= strongThreshold;
          const matchOpacity = strong ? 0.73 : 0.55;
          const attributes = {
            size: 1.15 + score * 0.65,
            color: color(strong ? "edge-strong" : "edge-regular"),
            baseOpacity: matchOpacity,
            matchOpacity,
          };
          const edge = graph.edge(source, target);
          if (edge !== undefined) {
            graph.mergeEdgeAttributes(edge, attributes);
            keys.add(edge);
          } else {
            keys.add(graph.addUndirectedEdge(source, target, { ...attributes, viewOpacity: view.type === "ready" ? 1 : 0 }));
          }
        }
        return keys;
      }

      let visibleEdges = mergeGraph(message);
      const sigma = new Sigma(graph, container, {
        settings: {
          enableNodeDrag: true,
          enableEdgeEvents: true,
          edgePickingPadding: 3,
          nodePickingPadding: 3,
          autoRescale: "once",
          itemSizesReference: "screen",
          renderEdgeLabels: false,
          stagePadding: Math.min(100, Math.max(36, container.clientWidth * 0.07)),
        },
        primitives: {
          nodes: {
            variables: {
              outlineColor: { type: "color", default: color("text") },
              outlineWidth: { type: "number", default: 1 },
            },
            layers: [nodeOutline],
          },
        },
        styles: {
          nodes: [
            DEFAULT_STYLES.nodes,
            {
              cursor: "grab",
              outlineColor: { attribute: "outlineColor" },
              outlineWidth: 1,
              opacity: { attribute: "viewOpacity" },
              labelColor: color("text"),
              labelVisibility: "hidden",
              backdropColor: color("surface"),
              backdropShadowColor: "#242c2a25",
            },
            { whenState: "isHovered", then: {
              size: 5.5, outlineColor: color("text"), outlineWidth: 1.5,
              labelVisibility: "visible", backdropPadding: 5,
            } },
            { whenState: "isHighlighted", then: {
              size: 6.5, depth: "topNodes", outlineColor: color("accent"), outlineWidth: 2.5,
            } },
            { whenState: "isDragged", then: { cursor: "grabbing" } },
          ],
          edges: [
            DEFAULT_STYLES.edges,
            { cursor: "pointer", opacity: attributes => attributes.baseOpacity * attributes.viewOpacity },
            { whenState: "isHovered", then: { color: color("text"), size: 2.5, opacity: { attribute: "viewOpacity" } } },
            { whenState: "isHighlighted", then: { color: color("accent"), size: 3.3, opacity: { attribute: "viewOpacity" } } },
          ],
          stage: [{ whenState: "isDragging", then: { cursor: "grabbing" } }],
        },
      });
      renderer = sigma;
      let grouping: InspectionGrouping = "";
      let groupedPositions = new Map<string, GraphPosition>();
      let groupById = new Map<string, string>();
      const draggedDuringLayout = new Set<string>();
      let headings: Array<GraphPosition & { label: HTMLElement }> = [];

      sigma.on("afterRender", () => {
        for (const { label, x, y } of headings) {
          const point = sigma.graphToViewport({ x, y });
          label.hidden = sigma.getCamera().ratio < 0.55;
          label.style.left = `${Math.round(point.x)}px`;
          label.style.top = `${Math.round(point.y - 9)}px`;
        }
      });
      sigma.setCustomBBox(worldBounds);
      sigma.scheduleRefresh();

      function updateGrouping() {
        const grouped = grouping ? groupBusinesses(view.nodes, view.edges, grouping) : null;
        const bounds = grouped && layoutBounds(grouped.positions.values());
        groupById = grouped?.groupById ?? new Map();
        groupedPositions = new Map();
        headings = [];
        if (grouped && bounds) {
          const span = Math.max(1, bounds.x[1] - bounds.x[0], bounds.y[1] - bounds.y[0]);
          const scale = worldRadius * 2 / span;
          const centerX = (bounds.x[0] + bounds.x[1]) / 2;
          const centerY = (bounds.y[0] + bounds.y[1]) / 2;
          const place = ({ x, y }: GraphPosition) => ({
            x: worldCenter.x + (x - centerX) * scale,
            y: worldCenter.y + (y - centerY) * scale,
          });
          for (const [id, point] of grouped.positions) groupedPositions.set(id, place(point));
          headings = grouped.headings.map(({ id, label: title, x, y }) => {
            const label = document.createElement("span");
            label.textContent = title;
            if (grouping === "topic") label.style.setProperty("--topic-color", topics.get(id)!.color);
            return { ...place({ x, y }), label };
          });
        }
        groupLabels?.replaceChildren(...headings.map(({ label }) => label));
        graph.updateEachEdgeAttributes((id, attributes, source, target) => {
          if (!visibleEdges.has(id)) return attributes;
          const crossesGroups = groupById.get(source) !== groupById.get(target);
          return { ...attributes, baseOpacity: crossesGroups ? 0.25 : attributes.matchOpacity };
        }, { attributes: ["baseOpacity"] });
      }

      function animatePositions(targets: Map<string, GraphPosition>) {
        const starts = new Map(graph.mapNodes((id, { x, y }) => [id, { x, y }]));
        const startedAt = performance.now();
        const duration = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 320;

        function step(now: number) {
          const progress = duration ? Math.max(0, Math.min(1, (now - startedAt) / duration)) : 1;
          const eased = progress * progress * (3 - 2 * progress);
          graph.updateEachNodeAttributes((id, attributes) => {
            const target = targets.get(id);
            if (!target || draggedDuringLayout.has(id)) return attributes;
            const start = starts.get(id)!;
            return { ...attributes, x: start.x + (target.x - start.x) * eased, y: start.y + (target.y - start.y) * eased };
          }, { attributes: ["x", "y"] });
          if (progress < 1) layoutFrame = requestAnimationFrame(step);
          else container!.setAttribute("aria-busy", "false");
        }
        if (duration) layoutFrame = requestAnimationFrame(step);
        else step(startedAt);
      }

      function updateFilteredLayout() {
        cancelLayout();
        draggedDuringLayout.clear();
        if (!visibleNodes.size) {
          container!.setAttribute("aria-busy", "false");
          return;
        }
        container!.setAttribute("aria-busy", "true");
        if (!grouping && visibleNodes.size === message.positions.size && [...visibleNodes].every(id => message.positions.has(id))) {
          animatePositions(message.positions);
          return;
        }

        try {
          const groupId = (id: string) => groupById.get(id) ?? "";
          const visibleByGroup = Map.groupBy(visibleNodes, groupId);
          const edgesByGroup = Map.groupBy(view.edges.filter(({ source, target }) => groupId(source) === groupId(target)),
            ({ source }) => groupId(source));
          const batches: LayoutBatch[] = [...visibleByGroup].map(([group, ids]) => {
            let frame = { ...worldCenter, radius: worldRadius * Math.max(0.22, Math.sqrt(ids.length / INSPECTION_NODE_LIMIT)) };
            if (grouping) {
              const { x, y } = layoutBounds(ids.map(id => groupedPositions.get(id)!))!;
              frame = { x: (x[0] + x[1]) / 2, y: (y[0] + y[1]) / 2, radius: Math.max(1, Math.max(x[1] - x[0], y[1] - y[0]) / 2) };
            }
            return {
              nodes: ids.map(id => {
                const { x, y } = graph.getNodeAttributes(id);
                return { id, x, y };
              }),
              edges: edgesByGroup.get(group) ?? [],
              frame,
            };
          });
          const worker = new Worker(new URL("../../workers/inspection-layout.worker.ts", import.meta.url), { type: "module" });
          layoutWorker = worker;
          worker.onmessage = ({ data }: MessageEvent<LayoutResult>) => {
            if (layoutWorker !== worker) return;
            cancelLayout();
            if ("positions" in data) animatePositions(data.positions);
            else layoutFailed(data.error);
          };
          worker.onerror = event => {
            if (layoutWorker === worker) layoutFailed(event.message);
          };
          worker.postMessage(batches);
        } catch (error) {
          layoutFailed(error instanceof Error ? error.message : String(error));
        }
      }

      function layoutFailed(message: string) {
        cancelLayout();
        container!.setAttribute("aria-busy", "false");
        console.warn("Could not arrange the filtered inspection graph", message);
      }

      function reportVisibleCounts() {
        const count = `${visibleNodes.size.toLocaleString()} businesses · ${visibleEdges.size.toLocaleString()} links`;
        if (legendCount) legendCount.textContent = count;
        if (settingsCount) {
          settingsCount.textContent = `${visibleNodes.size.toLocaleString()} of ${view.matchingCount.toLocaleString()} matching businesses shown`;
        }
        if (empty) empty.hidden = visibleNodes.size > 0;
        container!.dataset.nodeCount = String(visibleNodes.size);
        container!.dataset.edgeCount = String(visibleEdges.size);
        container!.dataset.matchingNodeCount = String(view.matchingCount);
        container!.dataset.visibleNodeCount = String(visibleNodes.size);
        container!.dataset.visibleEdgeCount = String(visibleEdges.size);
      }

      function animateVisibility() {
        cancelAnimationFrame(filterFrame);
        const nodeOpacity = new Map(graph.mapNodes((id, { viewOpacity }) => [id, viewOpacity]));
        const edgeOpacity = new Map(graph.mapEdges((id, { viewOpacity }) => [id, viewOpacity]));
        const startedAt = performance.now();
        const duration = matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 180;
        function renderFade(now: number) {
          const progress = duration ? Math.max(0, Math.min(1, (now - startedAt) / duration)) : 1;
          const opacity = (from: number, visible: boolean) => from + (Number(visible) - from) * progress;
          graph.updateEachNodeAttributes((id, attributes) => ({
            ...attributes, viewOpacity: opacity(nodeOpacity.get(id)!, visibleNodes.has(id)),
          }), { attributes: ["viewOpacity"] });
          graph.updateEachEdgeAttributes((id, attributes) => ({
            ...attributes, viewOpacity: opacity(edgeOpacity.get(id)!, visibleEdges.has(id)),
          }), { attributes: ["viewOpacity"] });
          if (progress < 1) {
            filterFrame = requestAnimationFrame(renderFade);
          } else {
            for (const id of graph.edges()) if (!visibleEdges.has(id)) graph.dropEdge(id);
            for (const id of graph.nodes()) if (!visibleNodes.has(id)) graph.dropNode(id);
          }
        }
        if (duration) filterFrame = requestAnimationFrame(renderFade);
        else renderFade(startedAt);
      }

      let selectedNodes = new Set<string>();
      let highlightedEdges = new Set<string>();
      let scorePair: ReturnType<typeof createInspectionPairScorer> | undefined;
      function updateSelection(nodes: Set<string>) {
        const [firstNode] = nodes;
        let edges: string[] = [];
        if (nodes.size === 1) edges = graph.edges(firstNode);
        else if (nodes.size > 1) {
          edges = graph.edges().filter(id => graph.extremities(id).every(node => nodes.has(node)));
        }
        const nextEdges = new Set(edges.filter(id => visibleEdges.has(id)));
        sigma.setNodesState([...selectedNodes].filter(id => !nodes.has(id)), { isHighlighted: false });
        sigma.setNodesState([...nodes].filter(id => !selectedNodes.has(id)), { isHighlighted: true });
        sigma.setEdgesState([...highlightedEdges].filter(id => !nextEdges.has(id)), { isHighlighted: false });
        sigma.setEdgesState([...nextEdges].filter(id => !highlightedEdges.has(id)), { isHighlighted: true });
        selectedNodes = nodes;
        highlightedEdges = nextEdges;

        const restaurants = [...nodes].map(id => businesses.get(id)!);
        if (restaurants.length === 2) {
          scorePair ??= createInspectionPairScorer(view.nodes);
          const [first, second] = restaurants;
          renderInspectionDetails({
            type: "pair", restaurants: [first, second], score: scorePair(first.id, second.id),
          });
        } else if (restaurants.length > 2) {
          renderInspectionDetails({ type: "group", restaurants, remove: toggleNode });
        } else {
          renderInspectionDetails(restaurants.length ? { type: "node", restaurant: restaurants[0] } : null);
        }
      }
      function clearSelection() {
        updateSelection(new Set());
      }
      function toggleNode(node: string) {
        const nodes = new Set(selectedNodes);
        if (nodes.has(node)) nodes.delete(node);
        else nodes.add(node);
        updateSelection(nodes);
      }
      function selectEdge({ edge }: { edge: string }) {
        updateSelection(new Set(graph.extremities(edge)));
      }
      let dragRelease: Event | undefined;
      sigma.on("nodeDragStart", ({ allDraggedNodes }) => {
        for (const id of allDraggedNodes) draggedDuringLayout.add(id);
      });
      sigma.on("nodeDragEnd", ({ event }) => { dragRelease = event.original; });
      function wasDrag({ event }: SigmaEventPayload) {
        return event.original === dragRelease;
      }
      function handleNodeClick(event: SigmaEventPayload & { node: string }) {
        if (wasDrag(event) || !visibleNodes.has(event.node)) return;
        if (event.event.original.shiftKey || event.event.original.metaKey) toggleNode(event.node);
        else updateSelection(new Set([event.node]));
      }
      function handleEdgeClick(event: SigmaEventPayload & { edge: string }) {
        if (!wasDrag(event) && visibleEdges.has(event.edge)) selectEdge(event);
      }
      sigma.on("clickNode", handleNodeClick);
      sigma.on("clickEdge", handleEdgeClick);
      sigma.on("doubleClickNode", event => {
        event.preventSigmaDefault();
        handleNodeClick(event);
      });
      sigma.on("doubleClickEdge", event => {
        event.preventSigmaDefault();
        handleEdgeClick(event);
      });
      sigma.on("clickStage", event => {
        if (!wasDrag(event)) clearSelection();
      });
      sigma.on("doubleClickStage", event => {
        if (wasDrag(event)) event.preventSigmaDefault();
      });
      document.querySelector("#inspection-details-close")?.addEventListener("click", clearSelection);
      window.addEventListener("keydown", event => {
        if (event.key === "Escape" && selectedNodes.size) clearSelection();
      });
      if (settings && settingsButton && settingsForm) {
        const citySelect = settingsForm.querySelector<HTMLSelectElement>('select[name="city"]');
        for (const city of [...message.cities].sort((a, b) => a.localeCompare(b))) {
          if (city !== defaultInspectionFilters.city) citySelect?.add(new Option(city, city));
        }

        let filters = defaultInspectionFilters;
        let requestId = 0;
        let pending = false;
        dataWorker?.addEventListener("message", ({ data }: MessageEvent<WorkerResult>) => {
          if ((data.type !== "filtered" && data.type !== "error") || data.requestId !== requestId) return;
          pending = false;
          if (data.type === "error") {
            container!.setAttribute("aria-busy", "false");
            if (settingsCount) settingsCount.textContent = "Filters could not be applied. Try changing a filter again.";
            console.warn("Could not filter the inspection graph", data.message);
            return;
          }

          view = data;
          businesses = new Map(data.nodes.map(node => [node.id, node]));
          visibleNodes = new Set(businesses.keys());
          visibleEdges = mergeGraph(data);
          sigma.refresh();
          scorePair = undefined;
          updateSelection(new Set([...selectedNodes].filter(id => visibleNodes.has(id))));
          updateGrouping();
          reportVisibleCounts();
          animateVisibility();
          updateFilteredLayout();
        });

        function applySettings() {
          const form = new FormData(settingsForm!);
          const value = (name: string) => String(form.get(name) ?? "");
          const nextGrouping = value("grouping") as InspectionGrouping;
          const groupingChanged = grouping !== nextGrouping;
          grouping = nextGrouping;
          const nextFilters: InspectionFilters = {
            query: value("query"), city: value("city"), preparation: value("preparation"),
            topic: value("topic"), pattern: value("pattern"),
          };
          if (JSON.stringify(filters) !== JSON.stringify(nextFilters)) {
            filters = nextFilters;
            pending = true;
            requestId++;
            cancelLayout();
            container!.setAttribute("aria-busy", "true");
            if (settingsCount) settingsCount.textContent = "Updating businesses…";
            window.clearTimeout(filterTimer);
            const request: WorkerRequest = { type: "filter", requestId, filters: nextFilters };
            filterTimer = window.setTimeout(() => dataWorker?.postMessage(request), 100);
          } else if (groupingChanged && !pending) {
            updateGrouping();
            updateFilteredLayout();
          }
        }
        settingsForm.addEventListener("input", applySettings);
        settingsForm.addEventListener("submit", event => event.preventDefault());
        settingsButton.addEventListener("click", () => {
          clearSelection();
          settingsButton.setAttribute("aria-expanded", "true");
          settings.showModal();
        });
        document.querySelector("#inspection-settings-close")?.addEventListener("click", () => settings.close());
        settings.addEventListener("keydown", event => {
          if (event.key !== "Escape") return;
          event.preventDefault();
          settings.close();
        });
        settings.addEventListener("close", () => {
          settingsButton.setAttribute("aria-expanded", "false");
          settingsButton.focus();
        });
        document.querySelector("#inspection-settings-reset")?.addEventListener("click", () => {
          const groupingSelect = settingsForm.querySelector<HTMLSelectElement>('select[name="grouping"]');
          settingsForm.reset();
          if (groupingSelect) groupingSelect.value = grouping;
          applySettings();
        });
      }
      reportVisibleCounts();
      if (legend) {
        if (window.matchMedia("(max-width: 760px)").matches) legend.querySelector("details")?.removeAttribute("open");
        legend.hidden = false;
      }
      const timeToFirstRenderMs = Math.round(performance.now() - initializationStartedAt);
      container.setAttribute("aria-busy", "false");
      container.dataset.firstRenderMs = String(timeToFirstRenderMs);
      status.hidden = true;
    } catch (error) {
      showError(error instanceof Error ? error.message : "Graph rendering failed.");
    }
  }

  function loadRestaurantGraph() {
    if (!container || !status || initialized || leaving) return;
    initialized = true;
    status.textContent = "Loading restaurant inspection data…";

    try {
      dataWorker = new Worker(new URL("../../workers/inspection-graph.worker.ts", import.meta.url), { type: "module" });
      dataWorker.onmessage = (event: MessageEvent<WorkerResult>) => {
        const message = event.data;
        if (message.type === "progress") {
          updateProgress(message);
          return;
        }
        if (message.type === "error" && message.requestId === undefined) showError(message.message);
        if (message.type === "ready") void createGraph(message);
      };
      dataWorker.onerror = (event) => showError(event.message);
      const csvUrl = new URL("/playground/synology/inspection-data.csv.gz", window.location.href).href;
      const request: WorkerRequest = { type: "load", csvUrl };
      dataWorker.postMessage(request);
    } catch (error) {
      showError(error instanceof Error ? error.message : "The graph worker could not start.");
    }
  }

  if ("requestIdleCallback" in window) {
    window.requestIdleCallback(loadRestaurantGraph, { timeout: 1000 });
  } else {
    setTimeout(loadRestaurantGraph, 0);
  }

  window.addEventListener("pagehide", () => {
    leaving = true;
    dataWorker?.terminate();
    cancelAnimationFrame(filterFrame);
    window.clearTimeout(filterTimer);
    cancelLayout();
    renderer?.kill();
  }, { once: true });
</script>
