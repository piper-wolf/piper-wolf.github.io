---
import PlaygroundLayout from "../../layouts/PlaygroundLayout.astro";
import InspectionDetails from "../../components/playground/InspectionDetails.astro";

const description = "A full-screen graph of Seattle food establishments connected by similar inspection histories.";
const pageUrl = new URL("/playground/synology", Astro.site ?? Astro.url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  url: pageUrl,
  name: "Seattle Restaurant Inspection Similarity Graph",
  description,
};
---

<PlaygroundLayout
  title="Seattle Restaurant Inspection Similarity Graph"
  description={description}
  structuredData={structuredData}
>
  <div class="inspection-playground">
    <div
      id="synology-graph"
      role="img"
      aria-label="Restaurant inspection similarity graph. Shows up to 1,800 restaurant names with a violation on record and an inspection in the year ending on the latest inspection date in the data. Names with more inspection dates rank first. Locations sharing an exact name form one node. Edges compare lifetime violation codes weighted by the latest known risk category. Node color shows risk category."
      aria-busy="true"
    ></div>
    <aside id="inspection-legend" class="graph-legend" aria-label="Graph key" hidden>
      <strong>Inspection graph</strong>
      <span id="inspection-legend-count" class="legend-count"></span>
      <div class="legend-groups">
        <div>
          <span class="legend-label">Restaurant risk</span>
          <ul>
            <li><i class="risk-1"></i> Level 1</li>
            <li><i class="risk-2"></i> Level 2</li>
            <li><i class="risk-3"></i> Level 3</li>
            <li><i class="risk-unknown"></i> Unknown</li>
          </ul>
        </div>
        <div>
          <span class="legend-label">Similarity score</span>
          <ul>
            <li><i class="edge-regular"></i> 55% to &lt;75%</li>
            <li><i class="edge-strong"></i> 75% to 100%</li>
            <li><i class="edge-selected"></i> Selected</li>
          </ul>
        </div>
      </div>
    </aside>
    <InspectionDetails />
    <div id="synology-graph-status" role="status" aria-live="polite">Preparing restaurant inspection data…</div>
  </div>
</PlaygroundLayout>

<style>
  .inspection-playground {
    --graph-background: #f4f3ed;
    --graph-surface: #fffef9;
    --graph-text: #242c2a;
    --graph-muted: #535c56;
    --graph-border: #d9ddd2;
    --graph-accent: #643c80;
    --graph-risk-1: #a64128;
    --graph-risk-2: #997022;
    --graph-risk-3: #246b65;
    --graph-risk-unknown: #65757d;
    --graph-edge-regular: #a8b7ac;
    --graph-edge-strong: #536f63;
    --graph-font: system-ui, sans-serif;
    color: var(--graph-text);
    font-family: var(--graph-font);
  }

  #synology-graph {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background-color: var(--graph-background);
    background-image: radial-gradient(#dde1d6 0.8px, transparent 0.8px);
    background-size: 20px 20px;
  }

  .graph-legend {
    position: fixed;
    z-index: 1;
    top: 16px;
    left: 16px;
    padding: 12px 15px;
    border: 1px solid var(--graph-border);
    border-radius: 12px;
    background: var(--graph-surface);
    box-shadow: 0 4px 20px #242c2a0d;
    font-size: 13px;
  }

  .graph-legend strong { display: block; font-size: 15px; }
  .legend-count { display: block; margin-top: 2px; color: var(--graph-muted); font-size: 12px; }
  .legend-groups { display: flex; gap: 20px; margin-top: 10px; }
  .legend-label { font-size: 12px; font-weight: 650; }
  .graph-legend ul { display: grid; gap: 4px; list-style: none; margin: 5px 0 0; padding: 0; }
  .graph-legend li { display: flex; align-items: center; gap: 7px; }
  .graph-legend i { flex: none; width: 8px; height: 8px; border-radius: 50%; }
  .graph-legend .risk-1 { background: var(--graph-risk-1); }
  .graph-legend .risk-2 { background: var(--graph-risk-2); }
  .graph-legend .risk-3 { background: var(--graph-risk-3); }
  .graph-legend .risk-unknown { background: var(--graph-risk-unknown); }
  .graph-legend .edge-regular,
  .graph-legend .edge-strong,
  .graph-legend .edge-selected { width: 14px; height: 3px; border-radius: 2px; }
  .graph-legend .edge-regular { background: var(--graph-edge-regular); }
  .graph-legend .edge-strong { background: var(--graph-edge-strong); }
  .graph-legend .edge-selected { background: var(--graph-accent); }

  @media (max-width: 600px) {
    .graph-legend { top: 8px; left: 8px; padding: 8px 10px; font-size: 11px; }
    .legend-groups { gap: 12px; margin-top: 6px; }
  }

  #synology-graph-status {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    z-index: 2;
    color: var(--graph-text);
    background: var(--graph-background);
    font: 500 15px/1.5 var(--graph-font);
    text-align: center;
    pointer-events: none;
  }

  #synology-graph-status[data-error="true"] {
    color: #8f3427;
  }

  #synology-graph-status[hidden] {
    display: none;
  }
</style>

<script>
  import type { GraphNode, SimilarityEdge, SimilarityStats, AggregationStats } from "../../lib/inspection-graph";
  import type { LayoutRequest } from "../../workers/inspection-layout.worker";
  import { renderInspectionDetails } from "../../lib/inspection-details";

  const container = document.querySelector<HTMLDivElement>("#synology-graph");
  const status = document.querySelector<HTMLDivElement>("#synology-graph-status");
  const legend = document.querySelector<HTMLElement>("#inspection-legend");
  const legendCount = document.querySelector<HTMLElement>("#inspection-legend-count");
  const initializationStartedAt = performance.now();
  let renderer: import("sigma").Sigma | undefined;
  let dataWorker: Worker | undefined;
  let stopLayout: (() => void) | undefined;
  let leaving = false;
  let initialized = false;

  type WorkerResponse =
    | { type: "progress"; phase: "reading" | "scoring"; rowCount: number; restaurantCount?: number; candidatePairsScored?: number }
    | {
        type: "ready";
        nodes: GraphNode[];
        edges: SimilarityEdge[];
        aggregationStats: AggregationStats;
        similarityStats: SimilarityStats;
        parseErrorCount: number;
        compressedBytes: number;
        processingMs: number;
        scoringMs: number;
      }
    | { type: "error"; message: string };

  function showError(message: string) {
    if (!container || !status) return;
    console.error("Could not load restaurant inspection graph", message);
    container.setAttribute("aria-busy", "false");
    status.setAttribute("role", "alert");
    status.dataset.error = "true";
    status.textContent = "Restaurant inspection data could not be loaded. Reload the page to try again.";
  }

  function updateProgress(message: Extract<WorkerResponse, { type: "progress" }>) {
    if (!status) return;
    if (message.phase === "reading") {
      status.textContent = `Reading inspection records: ${message.rowCount.toLocaleString()}…`;
      return;
    }
    const candidates = message.candidatePairsScored
      ? ` ${message.candidatePairsScored.toLocaleString()} candidate pairs scored…`
      : "";
    status.textContent = `Scoring similarities for ${(message.restaurantCount ?? 0).toLocaleString()} restaurants…${candidates}`;
  }

  async function createGraph(message: Extract<WorkerResponse, { type: "ready" }>) {
    if (!container || !status) return;
    try {
      const [{ default: Sigma, DEFAULT_STYLES }, { default: Graph }] = await Promise.all([
        import("sigma"),
        import("graphology"),
      ]);
      if (leaving) return;
      const graph = new Graph();
      const degree = new Uint8Array(message.nodes.length);
      for (const edge of message.edges) {
        degree[Number(edge.source)]++;
        degree[Number(edge.target)]++;
      }

      const theme = getComputedStyle(container);
      const color = (name: string) => theme.getPropertyValue(`--graph-${name}`).trim();
      const riskColors = { "1": color("risk-1"), "2": color("risk-2"), "3": color("risk-3"), Unknown: color("risk-unknown") };
      const regularEdge = color("edge-regular");
      const strongEdge = color("edge-strong");
      for (const node of message.nodes) {
        graph.addNode(node.id, {
          label: node.name,
          x: node.x,
          y: node.y,
          size: 2.1 + Math.min(1.2, degree[Number(node.id)] * 0.2),
          color: riskColors[node.riskCategory],
          riskCategory: node.riskCategory,
          businessIdCount: node.businessIdCount,
          inspections: node.inspections,
          lifetimeViolationCodes: node.lifetimeViolationCodes,
          realViolationCodes: node.realViolationCodes,
        });
      }
      for (const edge of message.edges) {
        graph.addUndirectedEdge(edge.source, edge.target, {
          size: 0.8 + edge.score * 0.6,
          color: edge.score >= 0.75 ? strongEdge : regularEdge,
          score: edge.score,
        });
      }

      container.dataset.nodeCount = String(graph.order);
      container.dataset.edgeCount = String(graph.size);
      const sigma = new Sigma(graph, container, {
        settings: {
          enableNodeDrag: true,
          enableEdgeEvents: true,
          edgePickingPadding: 3,
          nodePickingPadding: 3,
          autoRescale: true,
          itemSizesReference: "screen",
          renderEdgeLabels: false,
          labelDensity: 0.09,
          labelGridCellSize: 100,
          labelRenderedSizeThreshold: 3,
          stagePadding: Math.min(110, Math.max(48, container.clientWidth * 0.08)),
        },
        styles: {
          nodes: [
            DEFAULT_STYLES.nodes,
            { cursor: "grab", labelColor: color("text"), backdropColor: color("surface"), backdropShadowColor: "#242c2a25" },
            { whenState: "isHovered", then: { size: 5, backdropPadding: 5 } },
            { whenState: "isHighlighted", then: {
              size: 6, depth: "topNodes", labelVisibility: "visible", backdropVisibility: "visible",
              backdropColor: color("surface"), backdropBorderColor: color("accent"), backdropBorderWidth: 1,
            } },
            { whenState: "isDragged", then: { cursor: "grabbing" } },
          ],
          edges: [
            DEFAULT_STYLES.edges,
            { cursor: "pointer" },
            { whenState: "isHovered", then: { color: color("text"), size: 2 } },
            { whenState: "isHighlighted", then: { color: color("accent"), size: 3 } },
          ],
          stage: [{ whenState: "isDragging", then: { cursor: "grabbing" } }],
        },
      });
      renderer = sigma;
      let selectedNodes: string[] = [];
      let selectedEdge: string | undefined;
      function clearHighlights() {
        sigma.setNodesState(selectedNodes, { isHighlighted: false });
        if (selectedEdge !== undefined) sigma.setEdgeState(selectedEdge, { isHighlighted: false });
        selectedNodes = [];
        selectedEdge = undefined;
      }
      function clearSelection() {
        clearHighlights();
        renderInspectionDetails(null);
      }
      function selectNode({ node }: { node: string }) {
        clearHighlights();
        selectedNodes = [node];
        sigma.setNodeState(node, { isHighlighted: true });
        renderInspectionDetails({ type: "node", restaurant: message.nodes[Number(node)] });
      }
      function selectEdge({ edge }: { edge: string }) {
        clearHighlights();
        selectedEdge = edge;
        const [source, target] = graph.extremities(edge);
        selectedNodes = [source, target];
        sigma.setNodesState(selectedNodes, { isHighlighted: true });
        sigma.setEdgeState(edge, { isHighlighted: true });
        renderInspectionDetails({
          type: "edge",
          source: message.nodes[Number(source)],
          target: message.nodes[Number(target)],
          score: graph.getEdgeAttribute(edge, "score"),
        });
      }
      sigma.on("clickNode", selectNode);
      sigma.on("clickEdge", selectEdge);
      // Sigma can classify successive clicks on different items as a double click.
      sigma.on("doubleClickNode", (event) => {
        event.preventSigmaDefault();
        selectNode(event);
      });
      sigma.on("doubleClickEdge", (event) => {
        event.preventSigmaDefault();
        selectEdge(event);
      });
      sigma.on("clickStage", clearSelection);
      document.querySelector("#inspection-details-close")?.addEventListener("click", clearSelection);
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && selectedNodes.length) clearSelection();
      });
      if (legend && legendCount) {
        legendCount.textContent = `${graph.order.toLocaleString()} restaurants · ${graph.size.toLocaleString()} links`;
        legend.hidden = false;
      }
      const timeToFirstRenderMs = Math.round(performance.now() - initializationStartedAt);
      container.setAttribute("aria-busy", "false");
      container.dataset.firstRenderMs = String(timeToFirstRenderMs);
      status.hidden = true;
      console.info("Restaurant inspection graph rendered", {
        ...message.aggregationStats,
        ...message.similarityStats,
        parseErrorCount: message.parseErrorCount,
        compressedBytes: message.compressedBytes,
        processingMs: message.processingMs,
        scoringMs: message.scoringMs,
        timeToFirstRenderMs,
      });

      if (graph.order < 2) {
        container.dataset.layoutSteps = "0";
        return;
      }
      const layout = new Worker(new URL("../../workers/inspection-layout.worker.ts", import.meta.url), { type: "module" });
      const requestLayout = (request: LayoutRequest) => layout.postMessage(request);
      const layoutStartedAt = performance.now();
      let steps = 0;
      const finishLayout = () => {
        layout.terminate();
        container.removeEventListener("pointerdown", finishLayout, true);
        container.removeEventListener("wheel", finishLayout, true);
        stopLayout = undefined;
        if (leaving) return;
        renderer?.setSetting("autoRescale", "once");
        container.dataset.layoutSteps = String(steps);
        container.dataset.layoutMs = String(Math.round(performance.now() - layoutStartedAt));
      };
      layout.onmessage = ({ data }: MessageEvent<Float32Array>) => {
        graph.updateEachNodeAttributes((id, attributes) => {
          attributes.x = data[Number(id) * 2];
          attributes.y = data[Number(id) * 2 + 1];
          return attributes;
        }, { attributes: ["x", "y"] });
        steps += 5;
        if (steps === 45) finishLayout();
        else requestLayout({ type: "step" });
      };
      layout.onerror = (event) => {
        console.warn("Restaurant graph layout stopped", event.message);
        finishLayout();
      };
      stopLayout = finishLayout;
      container.addEventListener("pointerdown", finishLayout, { capture: true });
      container.addEventListener("wheel", finishLayout, { capture: true, passive: true });
      requestLayout({
        type: "start",
        nodes: message.nodes.map(({ id, x, y }) => ({ id, x, y })),
        edges: message.edges,
      });
    } catch (error) {
      showError(error instanceof Error ? error.message : "Graph rendering failed.");
    }
  }

  function loadRestaurantGraph() {
    if (!container || !status || initialized || leaving) return;
    initialized = true;
    status.textContent = "Loading restaurant inspection data…";

    try {
      dataWorker = new Worker(new URL("../../workers/inspection-graph.worker.ts", import.meta.url), { type: "module" });
      dataWorker.onmessage = (event: MessageEvent<WorkerResponse>) => {
        const message = event.data;
        if (message.type === "progress") {
          updateProgress(message);
          return;
        }
        if (message.type === "error") {
          showError(message.message);
          return;
        }
        void createGraph(message);
        dataWorker?.terminate();
        dataWorker = undefined;
      };
      dataWorker.onerror = (event) => showError(event.message);
      const csvUrl = new URL("/playground/synology/inspection-data.csv.gz", window.location.href).href;
      dataWorker.postMessage({ csvUrl });
    } catch (error) {
      showError(error instanceof Error ? error.message : "The graph worker could not start.");
    }
  }

  if ("requestIdleCallback" in window) {
    window.requestIdleCallback(loadRestaurantGraph, { timeout: 1000 });
  } else {
    setTimeout(loadRestaurantGraph, 0);
  }

  window.addEventListener("pagehide", () => {
    leaving = true;
    stopLayout?.();
    dataWorker?.terminate();
    renderer?.kill();
  }, { once: true });
</script>
