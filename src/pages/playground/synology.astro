---
import PlaygroundLayout from "../../layouts/PlaygroundLayout.astro";

const description = "An interactive sample Synology network graph, rendered with Sigma.js.";
const pageUrl = new URL("/playground/synology", Astro.site ?? Astro.url).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  url: pageUrl,
  name: "Synology network graph",
  description,
};
---

<PlaygroundLayout title="Synology network graph" description={description} structuredData={structuredData}>
  <div
    id="synology-graph"
    role="img"
    aria-label="Synology network graph: a router connects to a Synology NAS, MacBook, and phone. The NAS connects to a backup drive and Synology Photos."
    aria-busy="true"
  ></div>
</PlaygroundLayout>

<style>
  #synology-graph {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: #f0eee7;
  }
</style>

<script>
  const container = document.querySelector<HTMLDivElement>("#synology-graph");
  let renderer: import("sigma").Sigma | undefined;

  async function renderGraph() {
    if (!container) return;
    try {
      const [{ default: Sigma }, { default: Graph }] = await Promise.all([
        import("sigma"),
        import("graphology"),
      ]);
      const graph = new Graph();
      const narrow = container.clientWidth < 600;
      const positions: Record<string, { x: number; y: number }> = narrow
        ? {
            router: { x: 0, y: 0 },
            nas: { x: 0.1, y: -1 },
            macbook: { x: -0.1, y: 2 },
            phone: { x: 0.1, y: 3.3 },
            backup: { x: -0.1, y: -2.2 },
            photos: { x: 0.1, y: -3.4 },
          }
        : {
            router: { x: 0, y: 0 },
            nas: { x: 1.2, y: 0.2 },
            macbook: { x: -0.8, y: 1.1 },
            phone: { x: -0.9, y: -1 },
            backup: { x: 2.4, y: 1 },
            photos: { x: 2.5, y: -0.8 },
          };
      graph.addNode("router", { ...positions.router, size: 18, label: "Router", color: "#a64128" });
      graph.addNode("nas", { ...positions.nas, size: 23, label: "Synology NAS", color: "#246b65" });
      graph.addNode("macbook", { ...positions.macbook, size: 15, label: "MacBook", color: "#60777a" });
      graph.addNode("phone", { ...positions.phone, size: 15, label: "Phone", color: "#60777a" });
      graph.addNode("backup", { ...positions.backup, size: 15, label: "Backup drive", color: "#b28a45" });
      graph.addNode("photos", { ...positions.photos, size: 15, label: "Synology Photos", color: "#b28a45" });
      graph.addEdge("router", "nas", { label: "LAN", size: 2 });
      graph.addEdge("router", "macbook", { label: "Wi-Fi", size: 2 });
      graph.addEdge("router", "phone", { label: "Wi-Fi", size: 2 });
      graph.addEdge("nas", "backup", { label: "Hyper Backup", size: 2 });
      graph.addEdge("nas", "photos", { label: "serves", size: 2 });

      renderer = new Sigma(graph, container, {
        settings: {
          renderEdgeLabels: !narrow,
          itemSizesReference: "screen",
          stagePadding: Math.min(150, Math.max(32, container.clientWidth * 0.15)),
        },
      });
    } catch (error) {
      console.error("Could not load the Synology graph", error);
    } finally {
      container.setAttribute("aria-busy", "false");
    }
  }

  if ("requestIdleCallback" in window) {
    window.requestIdleCallback(() => void renderGraph(), { timeout: 1000 });
  } else {
    setTimeout(() => void renderGraph(), 0);
  }

  window.addEventListener("pagehide", () => renderer?.kill(), { once: true });
</script>
