---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PigeonImage from "../../components/PigeonImage.astro";
import * as styles from "../../styles/site.css";
import { getImage } from "astro:assets";
import { pigeonPosts } from "../../data/pigeons";

const description = "A static collection of pigeon sightings from Seattle by Piper Wolf.";
const optimizedSocialImage = await getImage({ src: pigeonPosts[0].image, width: 1200, format: "jpeg" });
const socialImage = {
  src: optimizedSocialImage.src,
  width: Number(optimizedSocialImage.attributes.width),
  height: Number(optimizedSocialImage.attributes.height),
};
const siteUrl = Astro.site ?? Astro.url;
const collectionUrl = new URL("/pigeons/", siteUrl).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${collectionUrl}#webpage`,
  url: collectionUrl,
  name: "Seattle Pigeon Photos",
  description,
  isPartOf: { "@id": `${new URL("/", siteUrl).href}#website` },
  about: { "@type": "Thing", name: "Seattle pigeons" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: pigeonPosts.length,
    itemListElement: pigeonPosts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `Seattle pigeon photo no. ${post.number}`,
      url: new URL(`/pigeons/${post.number}/`, siteUrl).href,
    })),
  },
};
---

<BaseLayout
  title="Seattle pigeons"
  description={description}
  socialImage={socialImage}
  socialImageAlt={pigeonPosts[0].alt}
  structuredData={structuredData}
>
  <div class={styles.pageHeader}>
    <div>
      <p class={styles.eyebrow}>Are they smart? No. Are they endearing? Most certainly!</p>
      <h1 class={styles.pageTitle}>Seattle pigeons</h1>
    </div>
    <a class={styles.supportLink} href="https://buymeacoffee.com/piperwolf" target="_blank" rel="noopener noreferrer">
      ☕️ Fund coffee and birdseed!
    </a>
  </div>

  <section class={styles.feed} aria-label="Pigeon posts" data-feed>
    {pigeonPosts.map((post, index) => (
      <article id={post.number} class={styles.post}>
        <div class={styles.postPhoto}>
          <a class={styles.imageButton} href={`/pigeons/${post.number}/`} aria-label={`View pigeon no. ${post.number}`}>
            <PigeonImage
              src={post.image}
              alt={post.alt}
              imageClass={styles.image}
              loading={index === 0 ? "eager" : "lazy"}
            />
          </a>
        </div>
        <div class={styles.postDetails}>
          <div class={styles.postMeta}>
            <h2 class={styles.postTitle}>
              <a class={styles.postTitleLink} href={`/pigeons/${post.number}/`}>Pigeon no. {post.number}</a>
            </h2>
            <time datetime={post.dateTime}>{post.date}</time>
          </div>
          <p class={styles.postCaption}>{post.caption}</p>
        </div>
      </article>
    ))}
  </section>
  <div class={styles.feedEnd} data-feed-end aria-live="polite">
    <span>More sightings soon.</span>
  </div>
</BaseLayout>
