---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import PigeonImage from "../../components/PigeonImage.astro";
import PhotoDetails from "../../components/PhotoDetails.astro";
import * as styles from "../../styles/site.css";
import { getImage } from "astro:assets";
import { pigeonPosts } from "../../data/pigeons";
import type { ImageMetadata } from "astro";
import { resolve } from "node:path";
import { readPhotoMetadata } from "../../lib/photo-metadata.mjs";

export function getStaticPaths() {
  return pigeonPosts.map((post) => ({
    params: { number: post.number },
    props: { post },
  }));
}

const { post } = Astro.props;
const images = import.meta.glob<ImageMetadata>("../../assets/*.jpg", { eager: true, import: "default" });
const sourcePath = Object.entries(images).find(([, image]) => image.src === post.image.src)?.[0];
const metadata: Partial<Awaited<ReturnType<typeof readPhotoMetadata>>> = sourcePath
  ? await readPhotoMetadata(resolve("src/assets", sourcePath.split("/").at(-1)!)) : {};
const description = post.caption;
const optimizedSocialImage = await getImage({ src: post.image, width: 1200, format: "jpeg" });
const socialImage = {
  src: optimizedSocialImage.src,
  width: Number(optimizedSocialImage.attributes.width),
  height: Number(optimizedSocialImage.attributes.height),
};
const siteUrl = Astro.site ?? Astro.url;
const detailUrl = new URL(`/pigeons/${post.number}/`, siteUrl).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "@id": `${detailUrl}#primaryimage`,
  name: `Seattle pigeon photo no. ${post.number}`,
  description: post.alt,
  caption: post.caption,
  contentUrl: new URL(socialImage.src, siteUrl).href,
  url: detailUrl,
  encodingFormat: "image/jpeg",
  width: socialImage.width,
  height: socialImage.height,
  datePublished: post.dateTime,
  dateCreated: metadata.capturedAt,
  creator: { "@type": "Person", name: "Piper Wolf", url: new URL("/", siteUrl).href },
  contentLocation: { "@type": "Place", name: "Seattle, Washington" },
  mainEntityOfPage: { "@type": "WebPage", "@id": detailUrl },
};
---

<BaseLayout
  title={`Pigeon no. ${post.number}`}
  description={description}
  type="article"
  publishedTime={post.dateTime}
  socialImage={socialImage}
  socialImageAlt={post.alt}
  structuredData={structuredData}
>
  <article class={styles.detailPage}>
    <div class={styles.detailHeader}>
      <a class={styles.backLink} href={`/pigeons/#${post.number}`}><Icon name="arrowLeft" /><span>All pigeons</span></a>
      <div class={`${styles.postMeta} ${styles.detailMeta}`}>
        <span>Posted <time datetime={post.dateTime}>{post.date}</time></span>
      </div>
      <h1 class={styles.detailTitle}>Pigeon no. {post.number}</h1>
      <p class={styles.postCaption}>{post.caption}</p>
    </div>
    <PigeonImage
      src={post.image}
      alt={post.alt}
      imageClass={styles.detailImage}
      frameClass={styles.detailImageFrame}
      loading="eager"
      variant="detail"
    />
    <PhotoDetails post={post} metadata={metadata} />
  </article>
</BaseLayout>
