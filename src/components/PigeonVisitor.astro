<style>
  .pigeon-perch { position: absolute; inset: 0; pointer-events: none; visibility: hidden; }
  .pigeon-visitor { position: absolute; left: 0; top: 0; width: 40px; height: 40px; pointer-events: none; }
  .pigeon-visitor[data-enhanced]:not([data-flying]):not([data-walking]) { pointer-events: auto; }
  .pigeon-visitor svg { display: block; overflow: visible; }
  .pigeon-wing, .pigeon-flight-wing { transform-origin: 31px 34px; }
  .pigeon-flight-wing { display: none; }
  .pigeon-head { transform-origin: 42px 25px; }
  .pigeon-body { transform-origin: 34px 51px; }
  .pigeon-eye { transform-origin: 49px 15px; }
  .pigeon-feet { transform-origin: 33px 49px; }
  .pigeon-tail { transform-origin: 24px 43px; }
  .pigeon-visitor[data-enhanced]:not([data-flying]) .pigeon-body { animation: pigeon-breathe 4s ease-in-out infinite; }
  .pigeon-visitor[data-enhanced]:not([data-flying]) .pigeon-eye { animation: pigeon-blink 7s linear infinite; }
  .pigeon-visitor[data-idle="look"] .pigeon-head { animation: pigeon-look 1500ms ease-in-out; }
  .pigeon-visitor[data-enhanced][data-idle="peck"] .pigeon-body { animation: pigeon-peck-body 1200ms ease-in-out; }
  .pigeon-visitor[data-idle="peck"] .pigeon-head { animation: pigeon-peck-head 1200ms ease-in-out; }
  .pigeon-visitor[data-idle="stretch"] .pigeon-wing { animation: pigeon-stretch 1800ms ease-in-out; }
  .pigeon-visitor[data-flying] .pigeon-wing { display: none; }
  .pigeon-visitor[data-flying] .pigeon-flight-wing { display: block; animation: pigeon-flight-wing var(--flight-duration) linear; }
  .pigeon-visitor[data-flying] .pigeon-body { animation: pigeon-flight-body var(--flight-duration) ease-in-out; }
  .pigeon-visitor[data-flying] .pigeon-feet { animation: pigeon-tuck var(--flight-duration) ease-in-out; }
  .pigeon-visitor[data-flying] .pigeon-tail { transform: rotate(8deg); }
  .pigeon-visitor[data-walking] .pigeon-foot-back,
  .pigeon-visitor[data-walking] .pigeon-foot-front { animation: pigeon-step 360ms linear infinite; }
  .pigeon-visitor[data-walking] .pigeon-foot-front { animation-delay: -180ms; }
  .pigeon-visitor[data-enhanced][data-walking] .pigeon-body { animation: pigeon-walk-body 180ms ease-in-out infinite; }
  .pigeon-visitor[data-walking] .pigeon-head { animation: pigeon-walk-head 360ms linear infinite; }
  @keyframes pigeon-step { 0%, 100% { transform: translateX(2px); } 50% { transform: translate(-2px, -2px); } }
  @keyframes pigeon-walk-body { 50% { transform: translateY(-1px); } }
  @keyframes pigeon-walk-head { 0%, 100% { transform: translateX(-1px); } 50% { transform: translateX(2px); } }
  @keyframes pigeon-breathe { 50% { transform: scaleY(1.025); } }
  @keyframes pigeon-look { 30% { transform: translateY(-1px) rotate(-9deg); } 65% { transform: rotate(8deg); } }
  @keyframes pigeon-peck-body { 35%, 55% { transform: translateY(4px) rotate(22deg); } }
  @keyframes pigeon-peck-head { 35%, 55% { transform: translateY(10px) rotate(45deg); } 45% { transform: translateY(12px) rotate(48deg); } }
  @keyframes pigeon-stretch { 20%, 65% { transform: rotate(-38deg) scaleY(0.8); } 40% { transform: rotate(-20deg) scaleY(0.9); } }
  @keyframes pigeon-blink { 0%, 94%, 98%, 100% { transform: scaleY(1); } 96% { transform: scaleY(0.1); } }
  /* Rapid takeoff beats, an open-wing glide, then braking beats before landing. */
  @keyframes pigeon-flight-wing {
    0%, 12%, 24%, 36%, 76%, 90%, 100% { transform: rotate(10deg) scaleY(1); }
    6%, 18%, 30%, 70%, 83%, 96% { transform: rotate(-105deg) scaleY(0.7); }
    44%, 62% { transform: rotate(-25deg) scaleY(0.9); }
  }
  @keyframes pigeon-flight-body { 12%, 70% { transform: rotate(-8deg); } 88% { transform: rotate(5deg); } }
  @keyframes pigeon-tuck { 15%, 70% { transform: translateY(-3px) scaleY(0.55); } }
  @media (prefers-reduced-motion: reduce) { .pigeon-visitor svg * { animation: none !important; } }
  @media print { .pigeon-perch { display: none; } }
</style>

<script is:inline>
  (() => {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const load = () => {
      if (motion.matches) return;
      const later = () => setTimeout(() => {
        if (motion.matches) return;
        if (document.hidden) { ready(); return; }
        const script = document.createElement('script');
        script.type = 'module';
        script.src = '/pigeon-visitor.js';
        document.body.append(script);
      }, 1200);
      if ('requestIdleCallback' in window) requestIdleCallback(later);
      else later();
    };
    const ready = () => {
      if (!document.hidden) load();
      else document.addEventListener('visibilitychange', function visible() {
        if (document.hidden) return;
        document.removeEventListener('visibilitychange', visible);
        load();
      });
    };
    if (document.readyState === 'complete') ready();
    else window.addEventListener('load', ready, { once: true });
  })();
</script>
