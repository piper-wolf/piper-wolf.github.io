---
import { layout } from '../styles/layout';
const roomy = `screen and (min-width: calc(${layout.maxWidth} + 128px))`;
---

<!-- Fixed decoration: never reserves page space or lands in the footer. -->
<div class="pigeon-perch" aria-hidden="true" style={`--content-width: ${layout.maxWidth}`}>
  <span class="pigeon-visitor">
    <svg viewBox="0 0 64 64" width="40" height="40" focusable="false">
      <!-- Tapered tail, plump breast, small head, short beak and pink toes. -->
      <path d="M24 39 5 47q-2 2 1 3l22-3" fill="#525b6a" />
      <path d="m27 49-1 8m0-1-5 2m5-2 5 2m9-9-1 8m0-1-5 2m5-2 5 2" fill="none" stroke="#c17a83" stroke-width="2" stroke-linecap="round" />
      <g class="pigeon-body">
        <path d="M16 35c3-7 12-9 18-10l5-10 13 5-2 12c5 9 0 20-13 21-14 1-25-6-21-18Z" fill="#99a3af" />
        <path d="M37 24q0-7 5-10l10 6-2 12q-5 5-14 0Z" fill="#55887f" />
        <path d="M37 28q7 6 13 1l-1 6q-7 3-13-2Z" fill="#887398" />
        <path d="M47 36q6 11-7 14" fill="none" stroke="#b9c1c9" stroke-width="3" stroke-linecap="round" />
        <g class="pigeon-wing">
          <path d="M17 34c7-7 19-5 23 3-3 7-12 11-24 10-2-4-3-9 1-13Z" fill="#bdc5ce" />
          <path d="m27 32-6 11m13-9-6 11" fill="none" stroke="#535e70" stroke-width="3.5" stroke-linecap="round" />
          <path d="m18 46 13-2" fill="none" stroke="#929dab" stroke-width="1.5" stroke-linecap="round" />
        </g>
        <g class="pigeon-head">
          <path d="M36 17c-1-6 3-10 9-10 7 0 11 4 10 10-1 6-5 10-11 9-5-1-8-4-8-9Z" fill="#7c899a" />
          <path d="m54 17 7 3-8 2" fill="#404956" />
          <path d="M53 16q4 0 4 3l-4 1" fill="#eee8df" />
          <g class="pigeon-eye">
            <circle cx="49" cy="15" r="3" fill="#e3b887" />
            <circle cx="49.5" cy="15" r="2" fill="#222d38" />
            <circle cx="50" cy="14.3" r="0.65" fill="#fff" />
          </g>
        </g>
      </g>
    </svg>
  </span>
</div>

<style>
  .pigeon-perch { position: fixed; inset: 0; pointer-events: none; visibility: hidden; }
  .pigeon-visitor { position: fixed; left: max(12px, calc((100vw - var(--content-width)) / 2 - 52px)); top: clamp(0px, 30vh, calc(100vh - 48px)); width: 40px; height: 40px; pointer-events: none; }
  .pigeon-visitor svg { display: block; }
  .pigeon-wing { transform-origin: 31px 34px; }
  .pigeon-head { transform-origin: 42px 25px; }
  .pigeon-body { transform-origin: 34px 51px; }
  .pigeon-eye { transform-origin: 49px 15px; }
  .pigeon-visitor[data-enhanced]:not([data-flying]) .pigeon-body { animation: pigeon-breathe 4s ease-in-out infinite; }
  .pigeon-visitor[data-enhanced]:not([data-flying]) .pigeon-head { animation: pigeon-curious 9s ease-in-out infinite; }
  .pigeon-visitor[data-enhanced]:not([data-flying]) .pigeon-eye { animation: pigeon-blink 7s linear infinite; }
  .pigeon-visitor[data-flying] .pigeon-wing { animation: pigeon-flap 140ms ease-in-out infinite alternate; }
  @keyframes pigeon-breathe { 50% { transform: scaleY(1.025); } }
  @keyframes pigeon-curious { 0%, 65%, 85%, 100% { transform: rotate(0); } 72%, 78% { transform: translateY(1px) rotate(7deg); } }
  @keyframes pigeon-blink { 0%, 94%, 98%, 100% { transform: scaleY(1); } 96% { transform: scaleY(0.1); } }
  @keyframes pigeon-flap { to { transform: rotate(-65deg) scaleY(0.65); } }
  @media (prefers-reduced-motion: reduce) { .pigeon-visitor svg * { animation: none !important; } }
  @media print { .pigeon-perch { display: none; } }
</style>
<style is:global set:html={`@media ${roomy} { .pigeon-perch.pigeon-perch { visibility: visible; } }`} />

<script is:inline>
  (() => {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const load = () => {
      if (motion.matches) return;
      const later = () => setTimeout(() => {
        if (motion.matches) return;
        if (document.hidden) { ready(); return; }
        const script = document.createElement('script');
        script.type = 'module';
        script.src = '/pigeon-visitor.js';
        document.body.append(script);
      }, 1200);
      if ('requestIdleCallback' in window) requestIdleCallback(later);
      else later();
    };
    const ready = () => {
      if (!document.hidden) load();
      else document.addEventListener('visibilitychange', function visible() {
        if (document.hidden) return;
        document.removeEventListener('visibilitychange', visible);
        load();
      });
    };
    if (document.readyState === 'complete') ready();
    else window.addEventListener('load', ready, { once: true });
  })();
</script>
