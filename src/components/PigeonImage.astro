---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import * as styles from "../styles/site.css";
import { layout } from "../styles/layout";

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: "lazy" | "eager";
  imageClass: string;
  frameClass?: string;
  variant?: "feed" | "feature" | "detail";
}

const {
  src,
  alt,
  loading = "lazy",
  imageClass,
  frameClass = styles.imageFrame,
  variant = "feed",
} = Astro.props;

// Intrinsic pixels describe the source; rem dimensions mirror the CSS layout.
const contentWidth = `min(100vw - 2 * ${layout.gutter}, ${layout.maxWidth})`;
const fullWidth = `min(${src.width}px, ${contentWidth} - 2 * ${layout.frame})`;
const desktopWidth = {
  feed: `(${contentWidth} - ${layout.postGap}) / 1.4 - 2 * ${layout.frame}`,
  feature: `(${contentWidth} - ${layout.featureGap}) / 1.72 - 2 * ${layout.frame}`,
  detail: `min(${fullWidth}, ${80 * src.width / src.height}svh)`,
}[variant];
const sizes = `${variant !== "feature" ? `(max-width: ${layout.breakpoint}) and (orientation: portrait) 100vw, ` : ""}(max-width: ${layout.breakpoint}) calc(${fullWidth}), calc(${desktopWidth})`;
const widths = [...new Set([320, 480, 640, 768, 1024, 1440, 1920, src.width])]
  .filter((width) => width <= src.width)
  .sort((a, b) => a - b);
---

<span class:list={[frameClass, variant !== "feature" && styles.mobileEdgeToEdge]} data-pigeon-landing="photo">
  <Image
    src={src}
    alt={alt}
    class={imageClass}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : "auto"}
    decoding="async"
  />
</span>
