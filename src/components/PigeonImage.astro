---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import * as styles from "../styles/site.css";

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: "lazy" | "eager";
  imageClass: string;
  frameClass?: string;
  variant?: "feed" | "feature" | "detail";
}

const {
  src,
  alt,
  loading = "lazy",
  imageClass,
  frameClass = styles.imageFrame,
  variant = "feed",
} = Astro.props;

// Match the container, grid gaps, and 10px photo frames in site.css.ts.
const contentWidth = "min(100vw - 2 * clamp(1rem, 4vw, 1.5rem), 74rem)";
const fullWidth = `min(${src.width}px, ${contentWidth} - 20px)`;
const desktopWidth = {
  feed: `(${contentWidth} - 24px) / 1.28 - 20px`,
  feature: `(${contentWidth} - 48px) / 1.72 - 20px`,
  detail: `min(${fullWidth}, ${80 * src.width / src.height}svh)`,
}[variant];
const sizes = `${variant !== "feature" ? "(max-width: 48rem) and (orientation: portrait) 100vw, " : ""}(max-width: 48rem) calc(${fullWidth}), calc(${desktopWidth})`;
const widths = [...new Set([320, 480, 640, 768, 1024, 1440, 1920, src.width])]
  .filter((width) => width <= src.width)
  .sort((a, b) => a - b);
---

<span class:list={[frameClass, variant !== "feature" && styles.mobileEdgeToEdge]}>
  <Image
    src={src}
    alt={alt}
    class={imageClass}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : "auto"}
    decoding="async"
  />
</span>
