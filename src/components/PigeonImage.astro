---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import * as styles from "../styles/site.css";

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: "lazy" | "eager";
  imageClass: string;
  frameClass?: string;
  sizes?: string;
}

const {
  src,
  alt,
  loading = "lazy",
  imageClass,
  frameClass = styles.imageFrame,
  sizes = "(max-width: 700px) calc(100vw - 48px), 70vw",
} = Astro.props;
---

<span class={frameClass} style={`--image-ratio: ${src.width} / ${src.height};`}>
  <Image
    src={src}
    alt={alt}
    class={imageClass}
    widths={[480, 768, 1024, 1440, 1920]}
    sizes={sizes}
    loading={loading}
  />
</span>
