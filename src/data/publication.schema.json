{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piper-wolf.com/schemas/pigeon-publication-v1.json",
  "title": "Pigeon published photo data v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "photos"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "title",
          "alt",
          "date",
          "dateTime",
          "caption",
          "image"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "queueId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "dateTime": {
            "type": "string",
            "format": "date",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "caption": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\.jpg$"
          }
        }
      }
    }
  }
}
