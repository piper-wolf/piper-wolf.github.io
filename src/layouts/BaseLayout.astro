---
import * as styles from "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string;
  socialImage?: {
    src: string;
    width: number;
    height: number;
  };
  socialImageAlt?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = "Piper Wolf — notes, photographs, and pigeons from Seattle.",
  type = "website",
  noindex = false,
  publishedTime,
  socialImage,
  socialImageAlt = "Seattle pigeon photograph by Piper Wolf",
  structuredData,
} = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const currentPath = Astro.url.pathname;
const canonicalPath = currentPath === "/" || currentPath.endsWith("/") || currentPath.endsWith(".html") ? currentPath : `${currentPath}/`;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const pageTitle = `${title} — Piper Wolf`;
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="en" class={styles.box}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Piper Wolf" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#f5f3ed" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="Piper Wolf" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={new URL(socialImage.src, siteUrl)} />}
    {socialImage && <meta property="og:image:alt" content={socialImageAlt} />}
    {socialImage && <meta property="og:image:width" content={String(socialImage.width)} />}
    {socialImage && <meta property="og:image:height" content={String(socialImage.height)} />}
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={new URL(socialImage.src, siteUrl)} />}
    {socialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {serializedStructuredData && <script is:inline type="application/ld+json" set:html={serializedStructuredData} />}
    <title>{pageTitle}</title>
  </head>
  <body class={styles.page}>
    <a class={styles.skipLink} href="#main-content">Skip to content</a>
    <header class={styles.header}>
      <a class={styles.brand} href="/">Piper Wolf</a>
      <nav class={styles.nav} aria-label="Main navigation">
        <a class={styles.navLink} href="/" aria-current={currentPath === "/" ? "page" : undefined}>Home</a>
        <a class={styles.navLink} href="/pigeons/" aria-current={currentPath === "/pigeons/" ? "page" : currentPath.startsWith("/pigeons/") ? "location" : undefined}>Seattle pigeons</a>
      </nav>
    </header>
    <main id="main-content" class={styles.main} tabindex="-1">
      <slot />
    </main>
    <footer class={styles.footer}>
      <a class={styles.supportLink} href="https://buymeacoffee.com/piperwolf">☕️ Fund coffee and birdseed!</a>
    </footer>
    <script is:inline data-goatcounter="https://piperwolf.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </body>
</html>
