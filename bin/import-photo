#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage: $0 <from-path> [size]" >&2
  exit 1
fi

from_path=$1
size=${2:-1920x}
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
assets_dir="$repo_root/public/assets"

if [[ ! -f "$from_path" ]]; then
  echo "Photo not found: $from_path" >&2
  exit 1
fi

mkdir -p "$assets_dir"

if creation_date=$(stat -f '%SB' -t '%Y-%m-%d' "$from_path" 2>/dev/null) && [[ "$creation_date" != "-" ]]; then
  :
elif creation_date=$(stat -c '%w' -- "$from_path" 2>/dev/null | cut -d' ' -f1) && [[ "$creation_date" != "-" ]]; then
  :
else
  echo "Could not determine the photo creation date: $from_path" >&2
  exit 1
fi

output_path="$assets_dir/$creation_date.jpg"
suffix=2
while [[ -e "$output_path" ]]; do
  output_path="$assets_dir/$creation_date-$suffix.jpg"
  suffix=$((suffix + 1))
done

magick -- "$from_path" \
  -filter Lanczos \
  -resize "$size" \
  "$output_path"

echo "Imported: $output_path"
echo "Website path: /assets/${output_path##*/}"
